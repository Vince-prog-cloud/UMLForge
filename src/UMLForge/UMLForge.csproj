<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<AssemblyName>UmlForge</AssemblyName>
		<RootNamespace>UmlForge</RootNamespace>
		<Version>1.0.0</Version>
		<Product>UmlForge</Product>
		<Description>UML 2.5 modeling studio for Windows</Description>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	</PropertyGroup>
	<ItemGroup>
	  <Folder Include="Domain\Catalog\" />
	  <Folder Include="Domain\Validation\" />
	  <Folder Include="Infrastructure\" />
	  <Folder Include="Presentation\Geometry\" />
	  <Folder Include="Presentation\Canvas\" />
	  <Folder Include="Presentation\Controls\" />
	  <Folder Include="Presentation\Icons\" />
	  <Folder Include="Presentation\Views\" />
	  <Folder Include="Presentation\Rendering\" />
	</ItemGroup>
</Project>